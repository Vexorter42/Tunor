<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WFAC010 tells WinForms apps to drop DPI settings from the manifest and call
         Application.SetHighDpiMode instead. This is a WPF app: its entry point never
         runs WinForms' ApplicationConfiguration.Initialize(), so the manifest is the
         only thing that makes the process DPI-aware. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Tunor</AssemblyName>
    <RootNamespace>Tunor</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Shown on the file's Details tab in Explorer. -->
    <Product>Tunor</Product>
    <Company>Vexorter42</Company>
    <Description>Графический интерфейс для sing-box с поддержкой AmneziaWG</Description>
    <Copyright>© 2026 Vexorter42 · MIT</Copyright>
    <Version>2.2.1</Version>
    <FileVersion>2.2.1</FileVersion>
    <AssemblyVersion>2.2.1</AssemblyVersion>
    <!-- What the compiler records for each source file, and for the symbol file next
         to the binary, is otherwise the full path it was built from — which names the
         builder's home directory in a file published to everyone. Relative to the
         repository root, a build made anywhere records the same thing. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=.</PathMap>
    <!-- SourceLink otherwise records the full path of the tree it was built from,
         so that symbols can be matched to sources on GitHub. Normalising it keeps that
         working and keeps the builder's home directory out of the shipped file. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 256px source for in-app <Image> elements: WPF decodes an .ico's FIRST
         frame (16x16) and upscales it, which looks blurry at 30-34px. -->
    <Resource Include="Assets\app.png" />
    <!-- The catalog of ready rule lists that comes with the program; a newer one is fetched from the repository. -->
    <EmbeddedResource Include="..\catalog\catalog.json" LogicalName="catalog.json" />
  </ItemGroup>

</Project>
