<UserControl x:Class="Nyx.Views.ConfigsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Конфиги" Style="{StaticResource H1}"/>
            <TextBlock Text="Текстовый редактор служебных файлов"
                       Style="{StaticResource Dim}" Margin="0,4,0,16"/>
        </StackPanel>

        <!-- Tabs + profiles -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabConfig"   Content="config.json" Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" IsChecked="True" Tag="config" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabWarp"     Content="warp.conf" Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" Tag="warp" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGeo"      Content="geo.conf"  Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" Tag="geo" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- Profiles: named copies of this tunnel, switchable in one click -->
            <Border x:Name="ProfileBar" Style="{StaticResource Card}" Padding="14,10"
                    Margin="0,10,0,0" Visibility="Collapsed">
                <WrapPanel>
                    <TextBlock Text="Профиль:" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProfileBox" Width="200" Margin="0,0,8,0"
                              SelectionChanged="ProfileBox_SelectionChanged"/>
                    <Button x:Name="DeleteProfileBtn" Content="Удалить" Padding="12,6"
                            Style="{StaticResource GhostButton}" Margin="0,0,24,0"
                            Click="DeleteProfile_Click"/>
                    <TextBox x:Name="NewProfileBox" Width="170" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Имя для нового профиля, например «WARP домашний» или «geo Германия»"/>
                    <Button Content="Сохранить текущий как профиль" Padding="12,6"
                            Style="{StaticResource SecondaryButton}" Click="SaveProfile_Click"/>
                </WrapPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="13"
                     BorderThickness="0" Padding="16"
                     TextChanged="Editor_TextChanged"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="↻ Перечитать" Style="{StaticResource SecondaryButton}"
                    Click="Reload_Click"/>
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Dim}"/>
        </StackPanel>
    </Grid>
</UserControl>
