<UserControl x:Class="Nyx.Views.ConfigsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Конфиги" Style="{StaticResource H1}"/>
            <TextBlock Text="Текстовый редактор служебных файлов"
                       Style="{StaticResource Dim}" Margin="0,4,0,16"/>
        </StackPanel>

        <!-- Tabs + profiles -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabConfig"   Content="config.json" Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" IsChecked="True" Tag="config" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabWarp"     Content="warp.conf" Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" Tag="warp" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGeo"      Content="geo.conf"  Style="{StaticResource NavButton}"
                             GroupName="ConfigTab" Tag="geo" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- Profiles: named copies of this tunnel, switchable in one click -->
            <Border x:Name="ProfileBar" Style="{StaticResource Card}" Padding="14,10"
                    Margin="0,10,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Switch between saved profiles -->
                    <TextBlock Text="Профиль:" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProfileBox" Grid.Column="1" Visibility="Collapsed"
                              SelectionChanged="ProfileBox_SelectionChanged"/>
                    <TextBlock x:Name="NoProfilesText" Grid.Column="1" Style="{StaticResource Dim}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="пока нет — впиши имя ниже и сохрани текущий конфиг"/>
                    <Button x:Name="DeleteProfileBtn" Grid.Column="2" Content="Удалить" Padding="12,6"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            HorizontalAlignment="Left" Visibility="Hidden"
                            Click="DeleteProfile_Click"/>

                    <!-- Save what is in the editor under a new name -->
                    <TextBlock Grid.Row="1" Text="Новый:" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,8,10,0"/>
                    <TextBox x:Name="NewProfileBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                             Tag="Имя, например «WARP домашний» или «geo Германия»"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Сохранить текущий" Padding="12,6"
                            Style="{StaticResource SecondaryButton}" Margin="8,8,0,0"
                            Click="SaveProfile_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="13"
                     BorderThickness="0" Padding="16"
                     TextChanged="Editor_TextChanged"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="↻ Перечитать" Style="{StaticResource SecondaryButton}"
                    Click="Reload_Click"/>
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Dim}"/>
        </StackPanel>
    </Grid>
</UserControl>
