<Window x:Class="Nyx.Views.UpdateRulesetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновить списки правил"
        Width="560" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Icon="../Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Обновление списков правил" Style="{StaticResource H2}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,4,0,0"
                       Text="Скачивает .srs файлы во внутреннюю папку data/rulesets и конвертирует remote-группы в local. Если GitHub у тебя заблокирован — укажи зеркало (например https://ghproxy.net/)."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Mirror prefix (опционально)" Style="{StaticResource Dim}"/>
            <TextBox x:Name="MirrorBox" Margin="0,4,0,0"
                     Text="https://ghproxy.net/"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                       Text="Оставь пустым, чтобы качать напрямую с GitHub"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     Background="{StaticResource BgInputBrush}"
                     Foreground="{StaticResource TextBrush}"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="12" BorderThickness="0" Padding="10"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnDownload" Content="⇩ Скачать"
                    Style="{StaticResource PrimaryButton}"
                    Click="Download_Click" Margin="0,0,8,0" MinWidth="120"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
