<v:DialogPanel x:Class="Tunor.Views.UpdateRulesetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tunor.Views"
        Title="Обновить списки правил"
        Width="544" Height="420"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Обновление списков правил" Style="{StaticResource H2}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,4,0,0"
                       Text="Скачивает .srs файлы во внутреннюю папку data/rulesets и конвертирует remote-группы в local. Сначала качает напрямую с GitHub, а если он не отвечает — через зеркало ниже."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Запасное зеркало (необязательно)" Style="{StaticResource Dim}"/>
            <TextBox x:Name="MirrorBox" Margin="0,4,0,0"
                     Text="https://gh-proxy.com/"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                       Text="Пустое поле — только напрямую с GitHub, без зеркал"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     Background="{StaticResource BgInputBrush}"
                     Foreground="{StaticResource TextBrush}"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="12" BorderThickness="0" Padding="10"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnDownload" Content="⇩ Скачать"
                    Style="{StaticResource PrimaryButton}"
                    Click="Download_Click" Margin="0,0,8,0" MinWidth="120"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</v:DialogPanel>
