<v:DialogPanel x:Class="Tunor.Views.CatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tunor.Views"
        Title="Каталог списков"
        Width="620" Height="540"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Каталог списков" Style="{StaticResource H1}" Margin="0,0,28,0"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Готовые списки сайтов: отметьте нужные — они попадут в правила и сразу скачаются. Список можно потом убрать или поправить на странице правил."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Куда:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="RouteBox" Grid.Column="1" SelectedIndex="0"
                      Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrush}">
                <ComboBoxItem Content="Как рекомендует каталог" Tag=""/>
                <ComboBoxItem Content="Всё через WARP" Tag="warp"/>
                <ComboBoxItem Content="Всё через geo" Tag="geo"/>
            </ComboBox>
            <Button x:Name="BtnRefresh" Grid.Column="2" Content="Обновить каталог" Margin="10,0,0,0"
                    Style="{StaticResource GhostButton}" Click="Refresh_Click"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel" Margin="18,12,18,14"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnAdd" Content="Добавить отмеченные" Style="{StaticResource PrimaryButton}"
                    Click="Add_Click" MinWidth="200"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" MinWidth="100" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</v:DialogPanel>
