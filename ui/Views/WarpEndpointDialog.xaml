<v:DialogPanel x:Class="Tunor.Views.WarpEndpointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tunor.Views"
        Title="Точка выхода WARP"
        Width="540"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Точка выхода WARP" Style="{StaticResource H1}" Margin="0,0,28,0"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="От адреса, по которому Tunor достаёт WARP, зависит, из какого дата-центра Cloudflare ваш трафик выходит в интернет. Если сайт через WARP не открывается или тормозит, другая точка часто это лечит. Движок перезапускается — соединения прервутся на несколько секунд."/>

        <TextBlock Text="Сейчас в конфиге" Style="{StaticResource Dim}" Margin="0,16,0,4"/>
        <TextBlock x:Name="CurrentText" FontWeight="SemiBold"/>

        <TextBlock Text="Попробовать адрес" Style="{StaticResource Dim}" Margin="0,14,0,5"/>
        <ComboBox x:Name="Choice" Background="{StaticResource BgInputBrush}"
                  Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>

        <TextBlock Text="Сайт, который должен открыться" Style="{StaticResource Dim}" Margin="0,14,0,5"/>
        <TextBox x:Name="SiteBox" Text="www.youtube.com"/>

        <TextBlock x:Name="ResultText" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="BtnTry" Content="Применить и проверить" Style="{StaticResource PrimaryButton}"
                    Click="Try_Click" MinWidth="200"/>
            <Button x:Name="BtnNext" Content="Следующая точка" Style="{StaticResource SecondaryButton}"
                    Click="Next_Click" MinWidth="150" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnRevert" Content="Вернуть прежнюю" Style="{StaticResource GhostButton}"
                    Click="Revert_Click" IsEnabled="False"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" MinWidth="100" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</v:DialogPanel>
