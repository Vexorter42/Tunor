<Window x:Class="Nyx.Views.ProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор программы"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="420" MinHeight="400"
        Background="{StaticResource BgBrush}"
        Icon="../Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Выбери программу" Style="{StaticResource H1}"/>
            <TextBlock Text="Показаны программы с открытым окном. Правило будет на имя файла — оно сработает и после перезапуска программы."
                       Style="{StaticResource Dim}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" TextChanged="Filter_Changed" Tag="Поиск по имени или заголовку окна"
                     ToolTip="Поиск по имени или заголовку окна"/>
            <CheckBox x:Name="ShowAll" Grid.Column="1" Content="Все процессы" Margin="14,0,0,0"
                      VerticalAlignment="Center" Checked="ShowAll_Changed" Unchecked="ShowAll_Changed"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="List_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="16,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Exe}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LoadingText" Text="Собираю список процессов…"
                           Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="110"
                    Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button x:Name="BtnPick" Content="Выбрать" Style="{StaticResource PrimaryButton}" MinWidth="140"
                    IsEnabled="False" Click="Pick_Click"/>
        </StackPanel>
    </Grid>
</Window>
