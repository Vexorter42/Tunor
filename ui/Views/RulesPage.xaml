<UserControl x:Class="Nyx.Views.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Правила" Style="{StaticResource H1}"/>
            <TextBlock Text="Группы маршрутизации из data/rules.json" Style="{StaticResource Dim}" Margin="0,4,0,16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Группа" ToolTip="Новая группа" Padding="12,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="AddGroup_Click" Margin="0,0,8,0"/>
                <Button Content="🗑 Удалить" ToolTip="Удалить группу" Padding="12,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="DeleteGroup_Click" Margin="0,0,8,0"/>
                <Button Content="💾 Сохранить" ToolTip="Сохранить и применить" Padding="12,7"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveApply_Click" Margin="0,0,8,0"/>
                <Button Content="⇩ Обновить" ToolTip="Обновить списки правил" Padding="12,7"
                        Style="{StaticResource SecondaryButton}"
                        Click="UpdateRulesets_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Style="{StaticResource Dim}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Группы" Style="{StaticResource H2}"
                               Margin="16,12,16,8"/>
                    <ListBox x:Name="GroupsList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="GroupsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgInputBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgInputBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1"
                                            Background="#33FFFFFF" VerticalAlignment="Center"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="{Binding KindBadge}" FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Tag}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <DockPanel>
                    <!-- Header: tag + type -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Имя группы (tag)" Style="{StaticResource Dim}"/>
                            <TextBox x:Name="TagBox" Margin="0,4,0,0" TextChanged="TagBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="Тип" Style="{StaticResource Dim}"/>
                            <ComboBox x:Name="TypeBox" Margin="0,4,0,0" Width="120"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      SelectionChanged="TypeBox_SelectionChanged">
                                <ComboBoxItem Content="inline" Tag="inline"/>
                                <ComboBoxItem Content="remote" Tag="remote"/>
                                <ComboBoxItem Content="local"  Tag="local"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- INLINE editor -->
                    <DockPanel x:Name="InlinePanel" Margin="0,16,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Тип элементов:" Style="{StaticResource Dim}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="KindDomain" Content="domain"
                                             GroupName="ItemKind" Margin="0,0,16,0"
                                             Checked="Kind_Changed"/>
                                <RadioButton x:Name="KindProcess" Content="process_name"
                                             GroupName="ItemKind"
                                             Checked="Kind_Changed"/>
                            </StackPanel>

                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewItemBox" Grid.Column="0"
                                         KeyDown="NewItemBox_KeyDown"/>
                                <Button x:Name="AddItemBtn" Grid.Column="1" Content="+" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" MinWidth="80"
                                        Click="AddItem_Click"/>
                            </Grid>
                        </StackPanel>

                        <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="×" Width="24" Height="24"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextDimBrush}"
                                                FontSize="16" Cursor="Hand"
                                                Click="RemoveItem_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- REMOTE editor -->
                    <StackPanel x:Name="RemotePanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="URL" Style="{StaticResource Dim}"/>
                        <TextBox x:Name="UrlBox" Margin="0,4,0,12"
                                 TextChanged="RemoteField_Changed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Формат" Style="{StaticResource Dim}"/>
                                <TextBox x:Name="FormatBox" Margin="0,4,0,0"
                                         TextChanged="RemoteField_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Интервал обновления" Style="{StaticResource Dim}"/>
                                <TextBox x:Name="IntervalBox" Margin="0,4,0,0"
                                         TextChanged="RemoteField_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- LOCAL editor -->
                    <StackPanel x:Name="LocalPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="Путь к файлу (относительно папки приложения)"
                                   Style="{StaticResource Dim}"/>
                        <TextBox x:Name="PathBox" Margin="0,4,0,12"
                                 TextChanged="LocalField_Changed"/>

                        <TextBlock Text="Формат" Style="{StaticResource Dim}"/>
                        <TextBox x:Name="LocalFormatBox" Margin="0,4,0,12" Width="120"
                                 HorizontalAlignment="Left"
                                 TextChanged="LocalField_Changed"/>

                        <TextBlock Text="Исходный URL (для обновления)" Style="{StaticResource Dim}"/>
                        <TextBox x:Name="SourceUrlBox" Margin="0,4,0,0"
                                 TextChanged="LocalField_Changed"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyHint" Text="Выберите группу слева"
                               Style="{StaticResource Dim}" Margin="0,16,0,0"
                               Visibility="Collapsed"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Dim}"
                   Text="После сохранения config.json пересобирается автоматически"/>
    </Grid>
</UserControl>
