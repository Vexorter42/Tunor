<v:DialogPanel x:Class="Tunor.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tunor.Views"
        Title="Что нового"
        Width="544" Height="520"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
            <TextBlock Text="Что изменилось в этой версии" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Body" Margin="20,16,20,18"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Открыть на GitHub" Style="{StaticResource GhostButton}"
                    Click="Github_Click" Margin="0,0,8,0" MinWidth="150"/>
            <Button Content="Закрыть" Style="{StaticResource PrimaryButton}"
                    Click="Close_Click" MinWidth="110"/>
        </StackPanel>
    </Grid>
</v:DialogPanel>
