<UserControl x:Class="Tunor.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Настройки" Style="{StaticResource H1}"/>
            <TextBlock Text="Параметры settings.json" Style="{StaticResource Dim}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Режимы работы" Style="{StaticResource H2}"/>

                    <CheckBox x:Name="ChkTun" Content="TUN  — системный сетевой интерфейс"
                              Margin="0,16,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="Прозрачный перехват всего сетевого трафика"
                               Style="{StaticResource Dim}" Margin="26,2,0,0"/>

                    <CheckBox x:Name="ChkProxy" Content="Proxy  — HTTP/SOCKS-прокси"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="Запуск локального HTTP/SOCKS-прокси"
                               Style="{StaticResource Dim}" Margin="26,2,0,0"/>

                    <CheckBox x:Name="ChkLogging" Content="Logging  — запись логов"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="Сохранение логов sing-box"
                               Style="{StaticResource Dim}" Margin="26,2,0,0"/>

                    <CheckBox x:Name="ChkWatchdog" Content="Сторож — поднимать движок, если он упал"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="До 3 попыток за 5 минут. Не перезапускает, если причина не лечится перезапуском"
                               Style="{StaticResource Dim}" Margin="26,2,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkAutoLists" Content="Обновлять списки правил раз в неделю"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock x:Name="ListsAgeText" Text="Скачиваются в фоне через зеркало"
                               Style="{StaticResource Dim}" Margin="26,2,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkAutoUpdate" Content="Искать обновления программы"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="При запуске и дальше раз в несколько часов. Нашлась новая версия — на главной появится зелёная кнопка «Обновиться»"
                               Style="{StaticResource Dim}" Margin="26,2,0,0" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkHealth" Content="Следить за туннелями и сообщать, если один перестал отвечать"
                              Margin="0,12,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Text="Раз в несколько минут Tunor запрашивает страницу Cloudflare через каждый туннель. Два промаха подряд — сообщение у значка в трее; когда туннель вернётся — ещё одно, с длиной перерыва. История за неделю видна на главной"
                               Style="{StaticResource Dim}" Margin="26,2,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="Уровень журнала" Margin="0,16,0,0"/>
                    <ComboBox x:Name="CmbLogLevel" Margin="0,6,0,0" Width="300" HorizontalAlignment="Left"
                              Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}" SelectionChanged="LogLevel_Changed">
                        <ComboBoxItem Content="Только ошибки" Tag="error"/>
                        <ComboBoxItem Content="Предупреждения (по умолчанию)" Tag="warn"/>
                        <ComboBoxItem Content="Информация" Tag="info"/>
                        <ComboBoxItem Content="Подробно (debug)" Tag="debug"/>
                    </ComboBox>
                    <TextBlock Text="«Подробно» нужно, чтобы разобраться с обрывами: в журнал попадают рукопожатия туннелей. Там же появляются адреса открываемых сайтов, поэтому в отчёт о проблеме такие строки не попадают. Журнал пишется в файл и хранится 7 дней. Применяется после перезапуска движка."
                               Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Button Content="Открыть папку журналов" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLogs_Click"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Условия использования и туториал"
                                Style="{StaticResource SecondaryButton}" MinWidth="260"
                                Click="ShowWizard_Click"/>
                        <Button Content="Лицензии" Style="{StaticResource GhostButton}"
                                MinWidth="120" Margin="10,0,0,0" Click="Licenses_Click"/>
                    </StackPanel>
                    <TextBlock Text="Условия, подсказки по настройке и лицензии сторонних компонентов (sing-box, GPL v3)"
                               Style="{StaticResource Dim}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Маршрут по умолчанию (final)" Style="{StaticResource H2}"/>
                    <TextBlock Text="Куда направлять трафик, не подходящий ни под одно правило"
                               Style="{StaticResource Dim}" Margin="0,4,0,12"/>
                    <!-- "напрямую" plus one choice per tunnel, built in code from the list -->
                    <StackPanel x:Name="FinalChoices"/>
                    <TextBlock x:Name="FinalHint" Style="{StaticResource Dim}"
                               Margin="26,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Резервная копия" Style="{StaticResource H2}"/>
                    <TextBlock Text="Настройки, правила, туннели с ключами и ссылками подписок, профили — одним файлом: чтобы перенести на другой компьютер или вернуться к тому, что было. Списки правил в файл не входят, они скачиваются заново."
                               Style="{StaticResource Dim}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить в файл…" Style="{StaticResource SecondaryButton}"
                                MinWidth="170" Click="ExportBackup_Click"/>
                        <Button Content="Загрузить из файла…" Style="{StaticResource SecondaryButton}"
                                MinWidth="170" Margin="10,0,0,0" Click="ImportBackup_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BackupHint" Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SaveHint" Text="" Style="{StaticResource Dim}" Margin="4,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
