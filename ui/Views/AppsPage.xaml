<UserControl x:Class="Nyx.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Приложения" Style="{StaticResource H1}"/>
            <TextBlock Text="Куда ходит каждая программа — и как отправить её в туннель целиком"
                       Style="{StaticResource Dim}" Margin="0,4,0,16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="+ Выбрать запущенную программу" Style="{StaticResource PrimaryButton}"
                        Padding="14,8" Margin="0,0,8,0" Click="Pick_Click"/>
                <Button Content="Указать .exe…" Style="{StaticResource SecondaryButton}"
                        Padding="14,8" Margin="0,0,8,0" Click="Browse_Click"/>
                <Button Content="Очистить историю" Style="{StaticResource GhostButton}"
                        Padding="14,8" Click="ClearHistory_Click"
                        ToolTip="Забыть, куда ходили программы за этот сеанс. Правила не трогает."/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Programs -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Программы" Style="{StaticResource H2}" Margin="16,12,16,8"/>
                    <Grid>
                        <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="AppsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="16,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,1"
                                                Background="{StaticResource BgInputBrush}" VerticalAlignment="Top"
                                                Margin="8,1,0,0">
                                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}"
                                                       FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Exe}" Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextDimBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AppsEmpty" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="20"
                                   Text="Пока пусто. Запусти туннель и поработай в программах — они появятся здесь. Или выбери программу кнопкой сверху."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Text="Выбери программу слева"
                               Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="AppName" Style="{StaticResource H2}" FontSize="18"/>
                            <TextBlock x:Name="AppPath" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,14"/>

                            <TextBlock Text="Весь трафик программы" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="BtnWarp" Content="через WARP" Padding="14,7" MinWidth="130"
                                        Margin="0,0,8,6" Click="RouteWarp_Click"/>
                                <Button x:Name="BtnGeo" Content="через geo" Padding="14,7" MinWidth="130"
                                        Margin="0,0,8,6" Click="RouteGeo_Click"/>
                                <Button x:Name="BtnNone" Content="по общим правилам" Padding="14,7" MinWidth="170"
                                        Margin="0,0,8,6" Click="RouteNone_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="RouteHint" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>

                            <TextBlock x:Name="HostsTitle" Text="Куда ходит за этот сеанс"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Домен можно добавить в список по отдельности. Для голых IP надёжнее завернуть всю программу."
                                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Адрес" Style="{StaticResource Dim}"/>
                                <TextBlock Grid.Column="1" Text="Сейчас" Style="{StaticResource Dim}"/>
                                <TextBlock Grid.Column="2" Text="Соед." Style="{StaticResource Dim}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Загружено" Style="{StaticResource Dim}" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Grid>
                            <ListBox x:Name="HostsList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="0,4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Host}" Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       ToolTip="{Binding Host}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Via}" Foreground="{Binding ViaBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Conns}" Foreground="{StaticResource TextDimBrush}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Down}" Foreground="{StaticResource TextDimBrush}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Visibility="{Binding ActionsVisibility}">
                                                <Button Content="→ WARP" Style="{StaticResource GhostButton}" Padding="8,3"
                                                        FontSize="11.5" Margin="0,0,4,0" Tag="{Binding Host}"
                                                        Click="HostWarp_Click" ToolTip="Добавить домен в список WARP"/>
                                                <Button Content="→ geo" Style="{StaticResource GhostButton}" Padding="8,3"
                                                        FontSize="11.5" Tag="{Binding Host}"
                                                        Click="HostGeo_Click" ToolTip="Добавить домен в список geo"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="HostsEmpty" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="380"/>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
