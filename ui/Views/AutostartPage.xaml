<UserControl x:Class="Nyx.Views.AutostartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Автозапуск" Style="{StaticResource H1}"/>
            <TextBlock Text="Запуск sing-box при входе в Windows через планировщик задач"
                       Style="{StaticResource Dim}" Margin="0,4,0,24" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse x:Name="StateDot" Width="10" Height="10"
                                 Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="Не установлено"
                                   Margin="8,0,0,0" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                               Text="Установка создаст задачу Nyx в планировщике (schtasks). При входе пользователя Nyx стартует свёрнутым в трей, ждёт 5 секунд и автоматически перезапускает sing-box."/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="BtnInstall" Content="✓ Включить автозапуск"
                                Style="{StaticResource PrimaryButton}"
                                Click="Install_Click" Margin="0,0,8,0" MinWidth="200"/>
                        <Button x:Name="BtnDelete" Content="✕ Выключить автозапуск"
                                Style="{StaticResource DangerButton}"
                                Click="Delete_Click" MinWidth="200"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" Style="{StaticResource Dim}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
