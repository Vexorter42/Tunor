<UserControl x:Class="Nyx.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Главная" Style="{StaticResource H1}"/>
            <TextBlock Text="Управление прокси-сервисом" Style="{StaticResource Dim}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Состояние" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="StateDot" Width="12" Height="12"
                                 Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="Остановлен" Margin="10,0,0,0"
                                   FontSize="16" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Shown when warp.conf / geo.conf are still the shipped templates. -->
                    <Border x:Name="SetupWarning" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="{StaticResource BgInputBrush}" CornerRadius="10" Padding="12,10">
                        <TextBlock x:Name="SetupWarningText" TextWrapping="Wrap" LineHeight="18"
                                   FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="BtnStart" Content="▶  Запустить"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnStartOrRestart_Click" Margin="0,0,8,0" MinWidth="180"/>
                        <Button x:Name="BtnStop" Content="■  Остановить"
                                Style="{StaticResource DangerButton}"
                                Click="BtnStop_Click" MinWidth="140"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Connection check: one request through each tunnel -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="BtnCheck" DockPanel.Dock="Right" Content="Проверить соединение"
                                Style="{StaticResource SecondaryButton}" Padding="14,7"
                                VerticalAlignment="Top"
                                Click="Check_Click"/>
                        <StackPanel>
                            <TextBlock Text="Проверка соединения" Style="{StaticResource H2}"/>
                            <TextBlock Text="Отправляет запрос через каждый туннель и показывает, откуда он вышел"
                                       Style="{StaticResource Dim}" Margin="0,4,12,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="CheckGrid" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock x:Name="CheckHint" Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Конфиги туннелей" Style="{StaticResource H2}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Если сайты перестали открываться — конфиг туннеля протух. Сгенерируй свежий по инструкции, а готовый файл добавь кнопкой ниже, перетаскиванием на окно или через Ctrl+V."/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="⚡  Сгенерировать WARP"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnGenWarp_Click" MinWidth="200" Margin="0,0,8,8"/>
                        <Button Content="🌍  Сгенерировать geo"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnGenGeo_Click" MinWidth="200" Margin="0,0,8,8"/>
                        <Button x:Name="BtnOpenConf" Content="📂  Добавить файл .conf"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnOpenConf_Click" MinWidth="200" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Обновления" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Текущая версия: —"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnCheckUpdate" Content="⭳  Проверить обновления"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnCheckUpdate_Click" MinWidth="220"/>
                        <TextBlock x:Name="UpdateStatus" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Быстрые ссылки" Style="{StaticResource H2}"/>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button Content="Открыть папку приложения"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenAppFolder_Click" Margin="0,4,4,4"/>
                        <Button Content="Открыть settings.json"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenSettingsFile_Click" Margin="4,4,0,4"/>
                        <Button Content="Открыть config.json"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenConfigFile_Click" Margin="0,4,4,4"/>
                        <Button Content="Открыть rules.json"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenRulesFile_Click" Margin="4,4,0,4"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Нравится проект?" Style="{StaticResource H2}"/>
                        <TextBlock Text="Поддержи разработку любой суммой — это помогает держать проект живым."
                                   Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="❤  Поддержать"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSupport_Click" MinWidth="150" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
