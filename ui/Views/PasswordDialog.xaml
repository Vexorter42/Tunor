<v:DialogPanel x:Class="Tunor.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tunor.Views"
        Title="Пароль"
        Width="470"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28">
        <TextBlock x:Name="HeadText" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,28,0"/>
        <TextBlock x:Name="BodyText" Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="Пароль" Style="{StaticResource Dim}" Margin="0,18,0,5"/>
        <PasswordBox x:Name="Pw" KeyDown="Pw_KeyDown"/>

        <StackPanel x:Name="RepeatPanel">
            <TextBlock Text="Ещё раз" Style="{StaticResource Dim}" Margin="0,12,0,5"/>
            <PasswordBox x:Name="Pw2" KeyDown="Pw_KeyDown"/>
        </StackPanel>

        <TextBlock x:Name="ProblemText" Foreground="{StaticResource DangerBrush}" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="BtnNone" Content="Без пароля" Style="{StaticResource GhostButton}"
                    Click="None_Click"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click" MinWidth="100" Margin="8,0,0,0"/>
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" MinWidth="120" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</v:DialogPanel>
