<Window x:Class="Nyx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nyx.Views"
        Title="Nyx" Height="640" Width="940"
        MinHeight="500" MinWidth="780"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Visibility="Visible"
        Icon="Assets/app.ico"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/app.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Nyx" Style="{StaticResource H1}"
                                   Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="StatusPill" Style="{StaticResource Badge}"
                            HorizontalAlignment="Left" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Остановлен" Margin="7,0,0,0"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer (version) -->
                <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom" Text="v1.0" Margin="22,0,22,18"
                           Style="{StaticResource Dim}"/>

                <!-- Nav -->
                <StackPanel Margin="14,0">
                    <RadioButton x:Name="NavHome" Content="Главная" Style="{StaticResource NavButton}"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" Tag="home"/>
                    <RadioButton x:Name="NavSettings" Content="Настройки" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="settings"/>
                    <RadioButton x:Name="NavRules" Content="Правила" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="rules"/>
                    <RadioButton x:Name="NavConfigs" Content="Конфиги" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="configs"/>
                    <RadioButton x:Name="NavApps" Content="Приложения" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="apps"/>
                    <RadioButton x:Name="NavConnections" Content="Соединения" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="connections"/>
                    <RadioButton x:Name="NavLogs" Content="Логи" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="logs"/>
                    <RadioButton x:Name="NavAutostart" Content="Автозапуск" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="autostart"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="PageHost" Grid.Column="1"/>

        <!-- Drop target overlay -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="#E61A1E25" IsHitTestVisible="False">
            <Border x:Name="DropFrame" Margin="40" CornerRadius="20" BorderThickness="2"
                    BorderBrush="{StaticResource AccentBrush}"
                    Background="{StaticResource BgPanelBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="DropTitle" Text="Отпустите файл" Style="{StaticResource H1}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="DropHint"
                               Text="Конфиг .conf будет определён автоматически — WARP или geo"
                               Style="{StaticResource Dim}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
