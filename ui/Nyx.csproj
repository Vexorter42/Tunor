<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WFAC010 tells WinForms apps to drop DPI settings from the manifest and call
         Application.SetHighDpiMode instead. This is a WPF app: its entry point never
         runs WinForms' ApplicationConfiguration.Initialize(), so the manifest is the
         only thing that makes the process DPI-aware. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Nyx</AssemblyName>
    <RootNamespace>Nyx</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.8.1</Version>
    <FileVersion>1.8.1</FileVersion>
    <AssemblyVersion>1.8.1</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 256px source for in-app <Image> elements: WPF decodes an .ico's FIRST
         frame (16x16) and upscales it, which looks blurry at 30-34px. -->
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
