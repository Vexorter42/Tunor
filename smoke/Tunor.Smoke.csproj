<!--
  Builds every page without a screen.

  The bugs this catches are the ones that keep happening: a resource looked up before the
  control is attached, a handler that runs during InitializeComponent, a binding to a
  property that is not there. None of them stop the build, and all of them kill a page the
  moment it is opened — which, until now, meant finding out by clicking on a Mac.

  Not shipped: nothing references it, and the app does not know it exists.

      dotnet run, from this folder
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tunor.Smoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <ProjectReference Include="../desktop/Tunor.Desktop.csproj" />
  </ItemGroup>

</Project>
