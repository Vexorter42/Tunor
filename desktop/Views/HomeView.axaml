<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Tunor.Desktop.Views"
             x:Class="Tunor.Desktop.Views.HomeView">
    <StackPanel Spacing="16">

        <StackPanel>
            <TextBlock Text="Главная" Classes="h1"/>
            <TextBlock Text="Управление движком" Classes="dim" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Classes="card">
            <StackPanel Spacing="14">
                <TextBlock Text="Состояние" Classes="h2"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel>
                    <Button x:Name="BtnStart" Classes="primary" Content="▶  Запустить"
                            MinWidth="160" Margin="0,0,10,6" Click="Start_Click"/>
                    <Button x:Name="BtnStop" Classes="danger" Content="■  Остановить"
                            MinWidth="140" Margin="0,0,10,6" Click="Stop_Click"/>
                    <Button x:Name="BtnStopElevated" Classes="danger" IsVisible="False"
                            Content="■  Остановить с правами" MinWidth="200"
                            Margin="0,0,10,6" Click="StopElevated_Click"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Classes="dim" TextWrapping="Wrap"/>
                <TextBlock x:Name="StateHint" Classes="dim" TextWrapping="Wrap"
                           IsVisible="False" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Права для режима TUN" Classes="h2"/>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Перехват всего трафика поднимает сетевой интерфейс, а на это нужны права root. По умолчанию приложение спрашивает пароль при каждом запуске — это системное окно macOS, пароль сюда не попадает."/>
                <TextBlock Classes="dim" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Служба движка держит эти права постоянно и избавляет от пароля, но пока ею управляет не приложение: с установленной службой туннель включается и выключается только установкой и удалением самой службы."/>
                <TextBlock x:Name="ServiceText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <!-- A row that cannot wrap pushes its last button off the card, which is
                     what happened to "Установить службу" on a narrow window. -->
                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="BtnService" Classes="ghost" Content="Проверить снова"
                            Margin="0,0,8,6" Click="Service_Click"/>
                    <Button x:Name="BtnInstall" Classes="primary" Content="Установить службу"
                            Margin="0,0,8,6" IsVisible="False" Click="Install_Click"/>
                    <Button x:Name="BtnUninstall" Classes="ghost" Content="Удалить службу"
                            Margin="0,0,8,6" IsVisible="False" Click="Uninstall_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Проверка соединения" Classes="h2"/>
                        <TextBlock Classes="dim" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Отправляет запрос через каждый туннель и показывает, откуда он вышел"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnCheck" Content="Проверить"
                            VerticalAlignment="Center" Click="Check_Click"/>
                </Grid>
                <ItemsControl x:Name="CheckList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="v:HomeView+CheckRow">
                            <Grid ColumnDefinitions="110,24,*,60,Auto" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Mark}"
                                           Foreground="{Binding MarkBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Ip}"
                                           FontFamily="Consolas,Menlo,monospace"/>
                                <TextBlock Grid.Column="3" Text="{Binding Country}" Classes="dim"/>
                                <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="dim"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CheckNote" Classes="dim" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="card" x:Name="AutostartCard">
            <StackPanel Spacing="10">
                <TextBlock Text="Автозапуск" Classes="h2"/>
                <CheckBox x:Name="ChkAutostart" Content="Запускать Tunor при входе в систему"
                          IsCheckedChanged="Autostart_Changed"/>
                <TextBlock x:Name="AutostartText" Classes="dim" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Движок" Classes="h2"/>
                <TextBlock x:Name="EngineText" Classes="dim" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
