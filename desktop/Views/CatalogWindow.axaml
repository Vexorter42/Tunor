<v:DialogPanel xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tunor.Desktop.Views"
        x:Class="Tunor.Desktop.Views.CatalogWindow"
        Title="Каталог списков" Width="620" Height="540"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Каталог списков" Classes="h1"/>
            <TextBlock Classes="dim" TextWrapping="Wrap"
                       Text="Готовые списки сайтов: отметьте нужные — они попадут в правила и сразу скачаются. Список можно потом убрать или поправить на странице правил."/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,10" ColumnSpacing="10">
            <TextBlock Text="Куда:" Classes="dim" VerticalAlignment="Center"/>
            <ComboBox x:Name="RouteBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Tag="">Как рекомендует каталог</ComboBoxItem>
                <ComboBoxItem Tag="warp">Всё через WARP</ComboBoxItem>
                <ComboBoxItem Tag="geo">Всё через geo</ComboBoxItem>
            </ComboBox>
            <Button x:Name="BtnRefresh" Grid.Column="2" Classes="ghost" Content="Обновить каталог" Click="Refresh_Click"/>
        </Grid>

        <Border Grid.Row="2" Classes="card">
            <ScrollViewer>
                <StackPanel x:Name="ListPanel" Spacing="2"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Classes="dim" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Classes="primary" Content="Добавить отмеченные" MinWidth="200" Click="Add_Click"/>
            <Button Content="Закрыть" MinWidth="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</v:DialogPanel>
