<v:DialogPanel xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tunor.Desktop.Views"
        x:Class="Tunor.Desktop.Views.WhatsNewWindow"
        Title="Что нового" Width="560" Height="520"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Classes="h1"/>
            <TextBlock Text="Что изменилось в этой версии" Classes="dim" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,14,0,0">
            <Button Classes="ghost" Content="Открыть на GitHub" Click="Github_Click"/>
            <Button Classes="primary" Content="Закрыть" MinWidth="110" Click="Close_Click"/>
        </StackPanel>
        <Border Classes="card">
            <ScrollViewer>
                <StackPanel x:Name="Body" Spacing="8"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</v:DialogPanel>
