<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Tunor.Desktop.Views"
             x:Class="Tunor.Desktop.Views.TunnelsView">
    <StackPanel Spacing="16">

        <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Туннели" Classes="h1"/>
                <TextBlock Text="Куда можно отправлять трафик" Classes="dim" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="📂  Добавить .conf" VerticalAlignment="Center"
                    Margin="0,0,8,0" Click="Import_Click"/>
            <Button Grid.Column="2" Classes="primary" Content="＋  Свой VPN"
                    VerticalAlignment="Center" Click="Add_Click"/>
        </Grid>

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="v:TunnelsView+Row">
                    <Border Classes="card" Margin="0,0,0,10" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <Border Classes="badge">
                                        <TextBlock Text="{Binding Badge}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Classes="dim" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Where}" Classes="dim" FontSize="11.5"
                                           IsVisible="{Binding ShowWhere}"
                                           FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="dim"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Classes="ghost" Content="Изменить"
                                    IsVisible="{Binding CanEdit}" Tag="{Binding Id}"
                                    Click="Edit_Click" Margin="0,0,6,0"/>
                            <Button Grid.Column="3" Classes="ghost" Content="Удалить"
                                    IsVisible="{Binding CanEdit}" Tag="{Binding Id}"
                                    Click="Delete_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Где лежат файлы туннелей" Classes="h2"/>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="WARP и geo читаются из файлов .conf в этой папке. Можно положить их туда самому — имена должны быть ровно warp.conf и geo.conf — или нажать «Добавить .conf», и приложение само разберётся, какой из них какой."/>
                <SelectableTextBlock x:Name="DataPathText" Classes="dim" FontSize="11.5"
                                     FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>
                <Button Classes="ghost" Content="Открыть папку" HorizontalAlignment="Left"
                        Click="OpenFolder_Click"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Classes="dim" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
