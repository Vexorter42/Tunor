<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Tunor.Desktop.Views"
             x:Class="Tunor.Desktop.Views.ConnectionsView">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Соединения" Classes="h1"/>
                <TextBlock Text="Что идёт через туннель прямо сейчас" Classes="dim" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" Width="240"
                         PlaceholderText="фильтр: адрес или программа"/>
                <CheckBox x:Name="ChkTunnelOnly" Content="Только через туннель"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" Padding="18,14">
            <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel>
                    <TextBlock Text="Загрузка" Classes="dim"/>
                    <TextBlock x:Name="DownText" Classes="h2"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Отдача" Classes="dim"/>
                    <TextBlock x:Name="UpText" Classes="h2"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Активных" Classes="dim"/>
                    <TextBlock x:Name="CountText" Classes="h2"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Classes="dim"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Border Classes="card" Padding="0">
            <ScrollViewer Padding="14">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="v:ConnectionsView+Row">
                            <Grid ColumnDefinitions="*,90,160,80,80" Margin="0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Host}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Route}"
                                           Foreground="{Binding RouteBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Process}" Classes="dim"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Down}" Classes="dim"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding Age}" Classes="dim"
                                           TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
