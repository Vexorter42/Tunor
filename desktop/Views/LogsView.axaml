<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tunor.Desktop.Views.LogsView">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Логи" Classes="h1"/>
                <TextBlock x:Name="SubText" Classes="dim" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <CheckBox x:Name="ChkFollow" Content="Автопрокрутка" IsChecked="True"/>
                <Button Classes="primary" Content="📋  Собрать отчёт" Click="Report_Click"/>
                <Button Classes="ghost" Content="Сохранить в файл" Click="Save_Click"/>
                <Button Classes="ghost" Content="Очистить" Click="Clear_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Classes="dim"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Border Classes="card" Padding="0">
            <ScrollViewer x:Name="Scroll" Padding="14">
                <SelectableTextBlock x:Name="LogText" FontFamily="Consolas,Menlo,monospace"
                                     FontSize="11.5" TextWrapping="NoWrap"
                                     Foreground="{StaticResource TextDimBrush}"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
