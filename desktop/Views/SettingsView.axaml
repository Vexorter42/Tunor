<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tunor.Desktop.Views.SettingsView">
    <StackPanel Spacing="16">
        <StackPanel>
            <TextBlock Text="Настройки" Classes="h1"/>
            <TextBlock x:Name="PathText" Classes="dim" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Режимы работы" Classes="h2"/>
                <CheckBox x:Name="ChkTun" Content="TUN — системный сетевой интерфейс"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock x:Name="TunHint" Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"/>
                <CheckBox x:Name="ChkProxy" Content="Proxy — HTTP/SOCKS-прокси"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock x:Name="ProxyHint" Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"/>
                <CheckBox x:Name="ChkLogging" Content="Logging — запись логов"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"
                           Text="Сохранение логов движка."/>
                <CheckBox x:Name="ChkWatchdog" Content="Сторож — поднимать движок, если он упал"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"
                           Text="До 3 попыток за 5 минут. Не перезапускает, если причина не лечится перезапуском."/>
                <CheckBox x:Name="ChkAutoLists" Content="Обновлять списки правил раз в неделю"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock x:Name="ListsAgeText" Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"/>
                <CheckBox x:Name="ChkAutoUpdate" Content="Искать обновления программы"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"
                           Text="При запуске и дальше раз в несколько часов. Нашлась новая версия — на главной появится зелёная кнопка «Обновиться»."/>
                <CheckBox x:Name="ChkHealth" Content="Следить за туннелями и сообщать, если один перестал отвечать"
                          IsCheckedChanged="Toggle_Changed"/>
                <TextBlock Classes="dim" Margin="24,-6,0,0" TextWrapping="Wrap"
                           Text="Раз в несколько минут Tunor запрашивает страницу Cloudflare через каждый туннель. Два промаха подряд — сообщение (на Linux — уведомление, на macOS — строка на главной); когда туннель вернётся — ещё одно, с длиной перерыва. История за неделю видна на главной."/>
                <TextBlock Text="Уровень журнала"/>
                <ComboBox x:Name="CmbLogLevel" Width="300" HorizontalAlignment="Left" SelectionChanged="LogLevel_Changed">
                    <ComboBoxItem Tag="error">Только ошибки</ComboBoxItem>
                    <ComboBoxItem Tag="warn">Предупреждения (по умолчанию)</ComboBoxItem>
                    <ComboBoxItem Tag="info">Информация</ComboBoxItem>
                    <ComboBoxItem Tag="debug">Подробно (debug)</ComboBoxItem>
                </ComboBox>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="«Подробно» нужно, чтобы разобраться с обрывами: в журнал попадают рукопожатия туннелей. Там же появляются адреса открываемых сайтов, поэтому в отчёт о проблеме такие строки не попадают. Журнал пишется в файл и хранится 7 дней. Применяется после перезапуска движка."/>
                <Button Classes="ghost" Content="Открыть папку журналов" HorizontalAlignment="Left"
                        Click="OpenLogs_Click"/>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Маршрут по умолчанию (final)" Classes="h2"/>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Куда направлять трафик, не подходящий ни под одно правило"/>
                <StackPanel x:Name="FinalChoices" Spacing="8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="О программе" Classes="h2"/>
                <TextBlock x:Name="AboutText" Classes="dim" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button Classes="ghost" Content="Лицензии" Margin="0,0,8,6"
                            Click="Licenses_Click"/>
                    <Button Classes="ghost" Content="Открыть папку приложения" Margin="0,0,8,6"
                            Click="OpenRoot_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Резервная копия" Classes="h2"/>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Настройки, правила, туннели с ключами и ссылками подписок, профили — одним файлом: чтобы перенести на другой компьютер или вернуться к тому, что было. Списки правил в файл не входят, они скачиваются заново."/>
                <WrapPanel>
                    <Button Content="Сохранить в файл…" Margin="0,0,8,6" Click="ExportBackup_Click"/>
                    <Button Content="Загрузить из файла…" Margin="0,0,8,6" Click="ImportBackup_Click"/>
                </WrapPanel>
                <TextBlock x:Name="BackupHint" Classes="dim" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Classes="dim" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
