<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tunor.Desktop.Views"
        x:Class="Tunor.Desktop.Views.ProcessPickerWindow"
        Title="Запущенные программы" Width="620" Height="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <TextBlock Text="Выбери программу" Classes="h2"/>
            <TextBlock Classes="dim" TextWrapping="Wrap"
                       Text="Имя берётся с запущенной программы, как её видит движок — набирать руками не нужно."/>
            <TextBox x:Name="FilterBox" PlaceholderText="Поиск"
                     TextChanged="Filter_Changed"/>
            <CheckBox x:Name="ShowAll" Content="Показывать системные процессы"
                      IsCheckedChanged="ShowAll_Changed"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Content="Отмена" MinWidth="110" Click="Cancel_Click"/>
            <Button x:Name="BtnPick" Classes="primary" Content="Выбрать" MinWidth="130"
                    Click="Pick_Click" IsEnabled="False"/>
        </StackPanel>

        <Border Classes="card" Padding="0">
            <Grid>
                <TextBlock x:Name="LoadingText" Classes="dim" Text="Смотрю, что запущено…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         SelectionChanged="List_SelectionChanged"
                         DoubleTapped="List_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="v:ProcessPickerWindow+Row">
                            <StackPanel Spacing="2" Margin="0,3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Extra}" Classes="dim" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Path}" Classes="dim" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>
