<v:DialogPanel xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tunor.Desktop.Views"
        x:Class="Tunor.Desktop.Views.PasswordWindow"
        Title="Пароль" Width="470"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock x:Name="HeadText" Classes="h2" TextWrapping="Wrap"/>
        <TextBlock x:Name="BodyText" Classes="dim" TextWrapping="Wrap"/>

        <TextBlock Text="Пароль" Classes="dim" Margin="0,8,0,-4"/>
        <TextBox x:Name="Pw" PasswordChar="●" KeyDown="Pw_KeyDown"/>

        <StackPanel x:Name="RepeatPanel" Spacing="10">
            <TextBlock Text="Ещё раз" Classes="dim" Margin="0,0,0,-4"/>
            <TextBox x:Name="Pw2" PasswordChar="●" KeyDown="Pw_KeyDown"/>
        </StackPanel>

        <TextBlock x:Name="ProblemText" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button x:Name="BtnNone" Classes="ghost" Content="Без пароля" Click="None_Click"/>
            <Button Content="Отмена" MinWidth="100" Click="Cancel_Click"/>
            <Button x:Name="BtnOk" Classes="primary" Content="OK" MinWidth="120" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</v:DialogPanel>
