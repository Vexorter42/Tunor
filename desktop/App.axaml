<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tunor.Desktop.App"
             Name="Tunor"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://TunorDesktop/Theme.axaml"/>
    </Application.Styles>
</Application>
