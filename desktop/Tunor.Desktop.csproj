<!--
  Tunor for macOS (and anywhere else), on Avalonia.

  The Windows app in ui/ is WPF and stays as it is. This one shares its brain through
  Tunor.Core — the config generator, tunnels, link and subscription parsing, rules and
  routing are the same code, compiled once — and brings its own face and its own few
  platform pieces (starting the engine, autostart).

  It targets plain net8.0, so it builds and runs on Windows too. That is deliberate: the
  macOS front end can be developed and watched here, and only the handful of things that
  are genuinely macOS get tested there.

      dotnet run project desktop/Tunor.Desktop.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tunor.Desktop</RootNamespace>
    <AssemblyName>TunorDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- The same number every system uses. All three are built from one tree, so
         giving them different versions only made it harder to say what someone is
         running; a build that needs re-cutting bumps this for everyone. -->
    <Version>2.2.1</Version>
    <!-- What the compiler records for each source file, and for the symbol file next
         to the binary, is otherwise the full path it was built from — which names the
         builder's home directory in a file published to everyone. Relative to the
         repository root, a build made anywhere records the same thing. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=.</PathMap>
    <!-- SourceLink otherwise records the full path of the tree it was built from,
         so that symbols can be matched to sources on GitHub. Normalising it keeps that
         working and keeps the builder's home directory out of the shipped file. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <!-- Symbols go inside the assembly rather than in a .pdb beside it. Avalonia's
         XAML compiler rewrites the assembly after the C# compiler is done and stamps
         the real path of that .pdb back into it, undoing PathMap above; embedded there
         is nothing to point at. Stack traces keep their line numbers either way. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The smoke test reaches the two internal doors ServiceClient leaves for it. -->
    <InternalsVisibleTo Include="Tunor.Smoke" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- The handshake with the privileged service, done without the keychain: see
         Services/MutualTls.cs. MIT licence, listed in THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Tunor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The starting rules. On Windows the installer puts this file in place; a macOS
         install is an empty folder, so the app carries its own copy and writes it on
         first run. Same content, so the two platforms start alike. -->
    <EmbeddedResource Include="Assets\default-rules.json" />
    <!-- The one icon, shared with the Windows app rather than copied: the window,
         the dock and the tray all want it, and two files would drift apart. -->
    <AvaloniaResource Include="..\ui\Assets\app.png" Link="Assets\app.png" />
  </ItemGroup>


</Project>
