<!--
  The Storm palette and the controls built from it, the same ones the Windows app uses.
  Kept as close to ui/Styles/Theme.xaml as Avalonia allows, so the two look like one
  program: same greens, same cards, same buttons.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- palette -->
        <Color x:Key="BgColor">#1A1E25</Color>
        <Color x:Key="BgPanelColor">#242932</Color>
        <Color x:Key="BgInputColor">#1F242B</Color>
        <Color x:Key="BgHoverColor">#2E343E</Color>
        <Color x:Key="BorderColor">#3A404A</Color>
        <Color x:Key="TextColor">#F4F6F7</Color>
        <Color x:Key="TextDimColor">#959DA9</Color>
        <Color x:Key="AccentColor">#3DDC5C</Color>
        <Color x:Key="AccentHoverColor">#5BE877</Color>
        <Color x:Key="AccentSoftColor">#383DDC5C</Color>
        <Color x:Key="DangerColor">#FF6B6B</Color>
        <Color x:Key="SuccessColor">#3DDC5C</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    </Styles.Resources>

    <!-- text -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- badge -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- buttons: the base is the secondary one -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#06280E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="TextBlock.Foreground" Value="#06280E"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="#2A0810"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- the sidebar entries -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg" Background="Transparent" CornerRadius="14"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- The green bar beside the chosen entry, as on Windows. -->
                        <Border Name="marker" Width="3" Height="16" CornerRadius="2"
                                Margin="-8,0,0,0" IsVisible="False"
                                Background="{StaticResource AccentBrush}"/>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bg">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#marker">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- inputs -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style Selector="CheckBox, RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

</Styles>
