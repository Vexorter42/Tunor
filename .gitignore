# .NET build output
bin/
obj/
*.user
.vs/
publish/
*.pdb

# Never commit build/runtime artefacts that an in-place install may drop
# next to the sources (the installer targets the same folder).
ui/*.dll
ui/*.exe
ui/*.deps.json
ui/*.runtimeconfig.json
ui/cs/
ui/de/
ui/es/
ui/fr/
ui/it/
ui/ja/
ui/ko/
ui/pl/
ui/pt-BR/
ui/ru/
ui/tr/
ui/zh-Hans/
ui/zh-Hant/

# Local packaging artefacts
dist/
out/
redist/
*.bak

# Never commit real tunnel configs / secrets
warp.conf
geo.conf
config.json
# ...but the tutorial's lesson about the config has a scene of that name, and the program is built without it if it is left out
!tutorial/scenes/config.json

# macOS build artefacts and the downloaded engine (72 MB, fetched at package time)
mac/out/
mac/engine/

# сборка релиза
build-out/
__pycache__/
*.pyc
bin/
obj/
build-mac/
build-mac-x64/

# generated by tutorial/video: the screens of the tutorial and the finished videos
tutorial/video/shots/
tutorial/video/out/
